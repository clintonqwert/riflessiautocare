# Riflessi Auto Care environment variables.
# Values live in Vercel project settings (encrypted) — never committed.
# Anything without NEXT_PUBLIC_ is server-only and must never appear in a
# client component.

# Canonical site origin (no trailing slash). REQUIRED in production — build
# throws if unset when NODE_ENV=production.
NEXT_PUBLIC_SITE_URL=

# Lead webhooks — each is a Formspree form endpoint (https://formspree.io/f/…)
# that emails the submission to the business inbox. REQUIRED in production:
# without one, that form fails loud and offers the visitor a mailto instead.
# Unset anywhere but the live site (local dev, Vercel previews) -> leads are
# logged to the server console instead, and the form shows its success state.
# Booking form on /contact.
BOOKING_WEBHOOK_URL=
# "Questions first?" contact form on /contact.
CONTACT_WEBHOOK_URL=

# Analytics — the sanctioned set is @vercel/analytics (visitor analytics)
# plus @vercel/speed-insights (real-user performance telemetry), both in
# src/app/layout.tsx. Zero-config on Vercel: no env vars needed. Do not add
# further tracking scripts without pruning — the perf budget assumes only
# these two.
